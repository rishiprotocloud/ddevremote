function villaagency_preprocess_node11111(array &$variables): void {

}
use Drupal\views\Views;

function villaagency_preprocess_node(array &$variables) {
  // Only apply to homepage content type
  if ($variables['node']->bundle() !== 'homepage') {
    return;
  }

    // Load the Featured Best Deal view block
    $banner_slider_view = Views::getView('banner_slider_view');
    if ($banner_slider_view) {
        $banner_slider_view->setDisplay('block_1'); // replace with your actual block machine name
        $banner_slider_view->preExecute();
        $banner_slider_view->execute();
        $variables['banner_slider_view_block'] = $banner_slider_view->render();
    }
  // Load the Featured Best Deal view block
  $view = Views::getView('featured_best_deal');
  if ($view) {
    $view->setDisplay('block_1'); // replace with your actual block machine name
    $view->preExecute();
    $view->execute();
    $variables['featured_best_deal_block'] = $view->render();
  }
}


