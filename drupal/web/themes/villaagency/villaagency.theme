function villaagency_preprocess_node(array &$variables) {
  // Only apply to homepage content type
  if ($variables['node']->bundle() !== 'homepage') {
    return;
  }

    // Load the Featured Best Deal view block
    $banner_slider_view = Views::getView('banner_slider_view');
    if ($banner_slider_view) {
        $banner_slider_view->setDisplay('block_1'); // replace with your actual block machine name
        $banner_slider_view->preExecute();
        $banner_slider_view->execute();
        $variables['banner_slider_view_block'] = $banner_slider_view->render();
    }
    // Load the Featured Best Deal view block
    $view = Views::getView('featured_best_deal');
    if ($view) {
      $view->setDisplay('block_1'); // replace with your actual block machine name
      $view->preExecute();
      $view->execute();
      $variables['featured_best_deal_block'] = $view->render();
    }
    $contact_us_section_view = Views::getView('contact_us_section_view');
    if ($contact_us_section_view) {
      $contact_us_section_view->setDisplay('block_1'); // replace with your actual block machine name
      $contact_us_section_view->preExecute();
      $contact_us_section_view->execute();
      $variables['contact_us_section_view_block'] = $contact_us_section_view->render();
    }
  
    $node = $variables['node'];
    $field_property_section_enable = $node->get('field_property_section_enable')->value;
    if($field_property_section_enable){
      // Get sorting type
      $sort_type = $node->get('field_sorting_type')->value ?: 'DESC';

      // Get number of properties
      $limit = $node->get('field_number_of_properties')->value ?: 6;

      // Get selected category (taxonomy term ID)
      $category_tid = $node->get('field_property_category')->target_id;

      // Build entity query
      $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery();
      switch ($sort_type) {
        case 'ASC':
          $query->sort('created', 'ASC');
          break;

        case 'PRICE_DESC':
          $query->sort('field_price', 'DESC');
          break;

        case 'PRICE_ASC':
          $query->sort('field_price', 'ASC');
          break;

        case 'TITLE_ASC':
          $query->sort('title', 'ASC');
          break;

        case 'TITLE_DESC':
          $query->sort('title', 'DESC');
          break;

        default:
          $query->sort('created', 'DESC'); // fallback
      }

      $query->accessCheck(TRUE) // ✅ Fix for Drupal 10 requirement
        ->condition('type', 'best_deal')
        ->condition('status', 1)
        ->range(0, $limit);

      // Apply category filter if set
      if ($category_tid) {
        $query->condition('field_type.target_id', $category_tid);
      }

      // Execute query
      $nids = $query->execute();
      $nodes = Node::loadMultiple($nids);

      // Pass to Twig
      $variables['filtered_properties'] = $nodes;
      $variables['field_property_section_enable'] = $field_property_section_enable;

    }
    
}


