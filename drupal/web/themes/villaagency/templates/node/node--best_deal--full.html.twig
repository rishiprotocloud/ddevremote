{#
/**
 * @file
 * Theme override for Best Deal nodes in full view mode.
 */
#}
<div class="single-property section">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <!-- Main Image -->
        <div class="main-image">
          {{ content.field_deal_image }}
        </div>

        <div class="main-content">
          <!-- Category (Type field ki sirf value) - Safe way -->
          <span class="category">
            {% if node.field_type is not empty %}
              {{ node.field_type.entity.name.value|capitalize }}
            {% else %}
              Appartment
            {% endif %}
          </span>

          <!-- Title -->
          <h4>{{ label }}</h4>

          <!-- Body -->
          {{ content.body }}
        </div>

        <div class="accordion" id="accordionExample">
        {% if node.field_faq_s_list is not empty %}
            {% for item in node.field_faq_s_list %}
            {% set paragraph = item.entity %}
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading{{ loop.index }}">
                <button class="accordion-button {% if not loop.first %}collapsed{% endif %}"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse{{ loop.index }}"
                        aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                        aria-controls="collapse{{ loop.index }}">
                    {{ paragraph.field_title.value }}
                </button>
                </h2>
                <div id="collapse{{ loop.index }}"
                    class="accordion-collapse collapse {% if loop.first %}show{% endif %}"
                    aria-labelledby="heading{{ loop.index }}"
                    data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    {{ paragraph.field_description.value|raw }}
                </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            {# Agar bilkul FAQs nahi hain to accordion section hi na dikhe #}
        {% endif %}
        </div>
      </div>

      <!-- Sidebar Info Table - Sirf Values -->
      <div class="col-lg-4">
        <div class="info-table">
          <ul>
            <li>
              <img src="/{{ directory }}/assets/images/info-icon-01.png" alt="" style="max-width: 52px;">
              <h4>
                {% if node.field_total_flat_space.value %}
                  {{ node.field_total_flat_space.value }}
                {% else %}
                  450
                {% endif %} m2<br><span>Total Flat Space</span>
              </h4>
            </li>
            <li>
              <img src="/{{ directory }}/assets/images/info-icon-02.png" alt="" style="max-width: 52px;">
              <h4>Contract<br><span>Contract Ready</span></h4>
            </li>
            <li>
              <img src="/{{ directory }}/assets/images/info-icon-03.png" alt="" style="max-width: 52px;">
              <h4>
                {% if node.field_payment_process.value %}
                  {{ node.field_payment_process.value }}
                {% else %}
                  Payment Process
                {% endif %}<br><span>Payment Process</span>
              </h4>
            </li>
            <li>
              <img src="/{{ directory }}/assets/images/info-icon-04.png" alt="" style="max-width: 52px;">
              <h4>Safety<br><span>24/7 Under Control</span></h4>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
 