{% set image_entity = row._entity.field_background_image.entity %}
{% if image_entity %}
    <style>
    .contact.section {
        background-image: url({{ file_url(image_entity.uri.value) }});
        
    }
    </style>
{% endif %}
<div class="contact section" >
  <div class="container">
    <div class="row">
      <div class="col-lg-4 offset-lg-4">
        <div class="section-heading text-center">
          <h6>| {{ fields.field_tag_line.content }}</h6>
          <h2>{{ fields.field_contact_us_heading.content }}</h2>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="contact-content">
  <div class="container">
    <div class="row">
      <div class="col-lg-7">
        {% set map_field = row._entity.field_contact_us_map_url %}
        {% if map_field %}
          {% set map_url = map_field.uri %}
          {% set map_title = map_field.title %}
          
          <div id="map">
            <iframe src="{{map_url}}" width="100%" height="500px" frameborder="0" style="border:0; border-radius: 10px; box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.15);" allowfullscreen=""></iframe>
          </div>

          
        {% endif %}

        
        
        {% set contact_items = row._entity.field_contact_info %}
        {% if contact_items %}
          <div class="row">
            {% for item in contact_items %}
              {% set paragraph = item.entity %}
              <div class="col-lg-6">
                <div class="item {{ paragraph.field_contact_info_class.value }}">
                  {% if paragraph.field_contact_info_icon.entity %}
                    <img src="{{ file_url(paragraph.field_contact_info_icon.entity.fileuri) }}" alt="Icon" style="max-width: 52px;">
                  {% endif %}
                  <h6>
                    {{ paragraph.field_contact_info_heading.value|raw }}
                  </h6>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

      </div>
      <div class="col-lg-5">
          {{ contact_form }}
      </div>
    </div>
  </div>
</div>
