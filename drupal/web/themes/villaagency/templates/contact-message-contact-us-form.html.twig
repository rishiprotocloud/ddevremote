<div class="row">
  <div class="col-lg-12">
    <fieldset>
      <label for="name">Full Name</label>
      {{ form.name }}
    </fieldset>
  </div>
  <div class="col-lg-12">
    <fieldset>
      <label for="email">Email Address</label>
      {{ form.mail }}
    </fieldset>
  </div>
  <div class="col-lg-12">
    <fieldset>
      <label for="subject">Subject</label>
      {{ form.subject }}
    </fieldset>
  </div>
  <div class="col-lg-12">
    <fieldset>
      <label for="message">Message</label>
      {{ form.message }}
    </fieldset>
  </div>
  <div class="col-lg-12">
    <fieldset>
      {{ form.actions }}
    </fieldset>
  </div>
</div>

{# Hidden fields jo Drupal ko chahiye #}
{{ form.form_build_id }}
{{ form.form_token }}
{{ form.form_id }}

